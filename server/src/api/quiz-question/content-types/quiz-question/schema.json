{
  "kind": "collectionType",
  "collectionName": "quiz_questions",
  "info": {
    "singularName": "quiz-question",
    "pluralName": "quiz-questions",
    "displayName": "Quiz Question"
  },
  "options": { "draftAndPublish": false },
  "attributes": {
    "question": { "type": "text", "required": true },
    "options": { "type": "json", "required": true },
    "correct_answer": { "type": "integer", "required": true },
    "explanation": { "type": "text" },
    "difficulty": {
      "type": "enumeration",
      "enum": ["easy", "medium", "hard"],
      "default": "medium"
    },
    "topic": { "type": "relation", "relation": "manyToOne", "target": "api::topic.topic", "inversedBy": "quiz_questions" }
  }
}